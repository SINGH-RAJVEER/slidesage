{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "VITE_API_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "RESEND_API_KEY",
    "GROQ_API_KEY",
    "GEMINI_API_KEY",
    "LITELLM_MODEL",
    "LITELLM_SEARCH_MODEL",
    "EMBEDDING_MODEL",
    "HOST",
    "PORT",
    "DATABASE_URL"
  ],
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "slide-sage-apis#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "format": {}
  }
}
