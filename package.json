{
	"name": "slidesage",
	"version": "0.3.1",
	"private": true,
	"workspaces": [
		"apps/*",
		"libs/*"
	],
	"scripts": {
		"build": "bun run build:web",
		"build:api": "CGO_ENABLED=0 go -C apps/api build ./...",
		"build:web": "bun --cwd apps/web build",
		"dev": "just dev",
		"dev:api": "CGO_ENABLED=0 go -C apps/api run ./cmd/api",
		"dev:worker": "CGO_ENABLED=0 go -C apps/api run ./cmd/worker",
		"dev:web": "bun --cwd apps/web dev",
		"dev:converter": "go -C apps/api run ./cmd/converter",
		"test": "bun run test:api && bun run test:cards && bun run test:ui && bun run test:web && bun run --cwd apps/edge test",
		"test:api": "CGO_ENABLED=0 go -C apps/api test -p 1 ./...",
		"test:web": "bun --cwd apps/web test",
		"test:ui": "bun --cwd libs/ui test",
		"test:cards": "bun --cwd libs/cards test",
		"type-check": "bun run type-check:web && bun run type-check:types && bun run type-check:ui && bun run type-check:cards && bun run --cwd apps/edge type-check",
		"type-check:web": "bun check --no-script -p apps/web",
		"type-check:types": "bun check --no-script -p libs/types",
		"type-check:ui": "bun check --no-script -p libs/ui",
		"type-check:cards": "bun check --no-script -p libs/cards",
		"lint": "bun run lint:api && bun run format:check",
		"lint:api": "CGO_ENABLED=0 go -C apps/api vet ./...",
		"migrate:api": "CGO_ENABLED=0 go -C apps/api run ./cmd/migrate",
		"migration:create": "goose -dir apps/api/migrations create",
		"format": "bun run format:api && bun run format:web",
		"format:api": "go -C apps/api fmt ./...",
		"format:web": "bun fmt --no-script apps/web apps/edge libs",
		"format:check": "bun fmt --no-script --check apps/web apps/edge libs"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"typescript": "^7.0.2",
		"wrangler": "4.153.0"
	},
	"trustedDependencies": [],
	"packageManager": "bun@1.4.4"
}
