gcp_project_id       = "slidesage-504414"
cloudflare_account_id = "your-cloudflare-account-id"

# Pass the token through TF_VAR_cloudflare_api_token rather than storing it here.
# Use commit tags or image digests. Do not use the mutable latest tag.
api_image     = "asia-south1-docker.pkg.dev/slidesage-504414/slidesage/api:<commit-sha>"
worker_image  = "asia-south1-docker.pkg.dev/slidesage-504414/slidesage/worker:<commit-sha>"
migrate_image = "asia-south1-docker.pkg.dev/slidesage-504414/slidesage/migrate:<commit-sha>"

# Use the endpoint shown for your Datadog site. Create DATADOG_OTLP_HEADERS in
# Secret Manager before enabling this value.
otel_exporter_otlp_endpoint = "https://otlp.datadoghq.com"
otel_service_version        = "<commit-sha>"
# Set to "none" if the Datadog GCP integration already collects Cloud Run logs.
otel_logs_exporter = "otlp"
