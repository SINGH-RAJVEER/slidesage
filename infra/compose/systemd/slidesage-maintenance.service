[Unit]
Description=SlideSage recovery and cleanup sweep
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=slidesage
WorkingDirectory=/opt/slidesage
# Skips the run while deploy.sh holds the lock.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 /opt/slidesage/.deploy.lock /usr/bin/docker compose run --rm maintenance
