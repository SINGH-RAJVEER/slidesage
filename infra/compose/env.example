# Copy to .env beside compose.json and fill in. chmod 600 .env.
#
# Compose reads this file twice: to fill ${...} in compose.json, and as the
# environment of api, worker, and maintenance. compose.json sets the database
# URL, cache, converter, proxy, and NODE_ENV values itself, so they are absent
# here. Compose expands $ in values; generate secrets with `openssl rand -hex 32`
# or wrap values containing $ in single quotes.

# Lets plain `docker compose` find compose.json in this directory.
COMPOSE_FILE=compose.json

# Release
# Registry path holding the api, worker, migrate, and converter images.
IMAGE_REGISTRY=ghcr.io/singh-rajveer/slidesage
# deploy.sh rewrites this line on each release.
IMAGE_TAG=replace-with-a-commit-sha

# Public addresses
API_DOMAIN=api.slidesage.app
# Comma-separated frontend origins for CORS and auth.
WEB_ORIGINS=https://slidesage.app,https://www.slidesage.app,https://slidesage.pages.dev,https://slide-sage.pages.dev

# PostgreSQL. The password goes into a URL, so keep it to letters and digits.
POSTGRES_USER=slidesage
POSTGRES_PASSWORD=
POSTGRES_DB=slidesage
DATABASE_CONNECT_TIMEOUT=10
DATABASE_IDLE_TIMEOUT=20
DATABASE_POOL_MAX=10

# Valkey read cache
VALKEY_PASSWORD=
VALKEY_MAXMEMORY=256mb
CACHE_TIMEOUT_MS=100

# Generation worker
WORKER_CONCURRENCY=2
WORKER_DATABASE_POOL_MAX=5

# Auth
AUTH_SECRET=
RATE_LIMIT_HASH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_DELIVERY_TIMEOUT_MS=10000

# Payments. All three are required; the API refuses to start without them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_REQUEST_TIMEOUT_MS=15000

# Generation providers
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=qwen/qwen3.8-27b:free
OPEN_ROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions
PROVIDER_VALIDATION_TIMEOUT_MS=15000
EXA_API_KEY=
EXA_REQUEST_TIMEOUT_MS=10000
# Leave empty to disable stock photos.
UNSPLASH_ACCESS_KEY=

# BYOK provider credential encryption: base64 of 32 random bytes,
# `openssl rand -base64 32`. Keep retired keys as BYOK_ENCRYPTION_KEY_V<n>.
BYOK_ENCRYPTION_KEY_CURRENT_VERSION=1
BYOK_ENCRYPTION_KEY=

# Card image storage. The service-account key goes in secrets/gcs-key.json.
PRESENTATION_GCS_BUCKET=

# OpenTelemetry. Leave the endpoint empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_RESOURCE_ENVIRONMENT=production
GEN_AI_CAPTURE_CONTENT=false

# backup.sh keeps this many daily dumps in backups/.
BACKUP_KEEP=14
