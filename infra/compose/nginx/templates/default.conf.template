# The nginx image renders this into /etc/nginx/conf.d/default.conf at startup,
# substituting the WEB_DOMAIN and API_DOMAIN environment variables only; nginx
# variables such as $host pass through untouched.
#
# cloudflare.conf, mounted beside it, sets the client address from
# CF-Connecting-IP and defines $from_cloudflare from the connecting address.
# Docker publishes ports around the host firewall, so every server checks it.

server_tokens off;

# One Cloudflare Origin CA certificate covers the apex and its subdomains.
# Cloudflare's SSL mode must be Full (strict).
ssl_certificate /etc/nginx/certs/origin.pem;
ssl_certificate_key /etc/nginx/certs/origin.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;

# Compress static files only. gzip_proxied is off, so API responses and the
# generation event stream pass through as the API wrote them.
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_types text/css application/javascript application/json image/svg+xml text/plain;

# Refuse TLS for any other name before a certificate is presented.
server {
	listen 443 ssl default_server;
	ssl_reject_handshake on;
}

server {
	listen 80 default_server;

	if ($from_cloudflare = 0) {
		return 444;
	}

	return 301 https://$host$request_uri;
}

server {
	listen 443 ssl;
	http2 on;
	server_name www.${WEB_DOMAIN};

	if ($from_cloudflare = 0) {
		return 444;
	}

	return 301 https://${WEB_DOMAIN}$request_uri;
}

# The frontend, baked into this image at /usr/share/nginx/html.
server {
	listen 443 ssl;
	http2 on;
	server_name ${WEB_DOMAIN};
	root /usr/share/nginx/html;

	if ($from_cloudflare = 0) {
		return 444;
	}

	# Vite fingerprints every file under /assets/, so its content never changes.
	# A missing chunk is a 404, not index.html, so the app's preload-error reload
	# sees the failure. Without `always`, the 404 is not marked immutable.
	location /assets/ {
		try_files $uri =404;
		add_header Cache-Control "public, max-age=31536000, immutable";
		add_header X-Content-Type-Options nosniff;
	}

	# index.html and the unhashed public files revalidate on every load, so a
	# release takes effect at once and never points at removed chunks. Any other
	# path is a client route.
	location / {
		try_files $uri /index.html;
		add_header Cache-Control "no-cache" always;
		add_header X-Content-Type-Options nosniff always;
	}
}

server {
	listen 443 ssl;
	http2 on;
	server_name ${API_DOMAIN};

	if ($from_cloudflare = 0) {
		return 444;
	}

	# Photo uploads accept 15 MiB plus multipart overhead.
	client_max_body_size 16m;

	# Resolve through Docker's DNS on every request so a recreated api
	# container is picked up without reloading nginx.
	resolver 127.0.0.11 valid=10s ipv6=off;
	set $api_upstream http://api:8000;

	location / {
		proxy_pass $api_upstream;
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Forwarded-Host $host;

		# The API trusts these with TRUST_PROXY_HEADERS=true. Overwrite every one
		# with the address realip took from Cloudflare so a client cannot set them.
		proxy_set_header CF-Connecting-IP $remote_addr;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Real-IP $remote_addr;

		# Generation progress is SSE. The API sends X-Accel-Buffering: no and a
		# keepalive every 10 seconds, so these only bound slow non-stream calls.
		proxy_read_timeout 300s;
		proxy_send_timeout 300s;
	}
}
