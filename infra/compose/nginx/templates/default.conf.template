# The nginx image renders this into /etc/nginx/conf.d/default.conf at startup,
# substituting the API_DOMAIN environment variable only; nginx variables such
# as $host pass through untouched.
#
# cloudflare.conf, mounted beside it, sets the client address from
# CF-Connecting-IP and defines $from_cloudflare from the connecting address.

server_tokens off;

# Refuse TLS for any name but the API before a certificate is presented.
server {
	listen 443 ssl default_server;
	ssl_reject_handshake on;
}

server {
	listen 80 default_server;

	if ($from_cloudflare = 0) {
		return 444;
	}

	return 301 https://${API_DOMAIN}$request_uri;
}

server {
	listen 443 ssl;
	http2 on;
	server_name ${API_DOMAIN};

	# Cloudflare Origin CA certificate. Cloudflare's SSL mode must be Full (strict).
	ssl_certificate /etc/nginx/certs/origin.pem;
	ssl_certificate_key /etc/nginx/certs/origin.key;
	ssl_protocols TLSv1.2 TLSv1.3;
	ssl_session_cache shared:SSL:10m;
	ssl_session_timeout 1d;

	# Docker publishes ports around the host firewall, so the Cloudflare-only
	# rule lives here. Direct hits would otherwise reach the API unproxied.
	if ($from_cloudflare = 0) {
		return 444;
	}

	# Photo uploads accept 15 MiB plus multipart overhead.
	client_max_body_size 16m;

	# Resolve through Docker's DNS on every request so a recreated api
	# container is picked up without reloading nginx.
	resolver 127.0.0.11 valid=10s ipv6=off;
	set $api_upstream http://api:8000;

	location / {
		proxy_pass $api_upstream;
		proxy_http_version 1.1;
		proxy_set_header Connection "";
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Proto https;
		proxy_set_header X-Forwarded-Host $host;

		# The API trusts these with TRUST_PROXY_HEADERS=true. Overwrite every one
		# with the address realip took from Cloudflare so a client cannot set them.
		proxy_set_header CF-Connecting-IP $remote_addr;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Real-IP $remote_addr;

		# Generation progress is SSE. The API sends X-Accel-Buffering: no and a
		# keepalive every 10 seconds, so these only bound slow non-stream calls.
		proxy_read_timeout 300s;
		proxy_send_timeout 300s;
	}
}
