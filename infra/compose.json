{
	"name": "slidesage",
	"services": {
		"postgres": {
			"image": "docker.io/pgvector/pgvector:0.8.7-pg18",
			"restart": "unless-stopped",
			"environment": {
				"POSTGRES_USER": "${POSTGRES_USER:-slidesage}",
				"POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}",
				"POSTGRES_DB": "${POSTGRES_DB:-slidesage}"
			},
			"volumes": [
				"postgres-data:/var/lib/postgresql"
			],
			"shm_size": "256m",
			"healthcheck": {
				"test": [
					"CMD-SHELL",
					"pg_isready -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""
				],
				"interval": "5s",
				"timeout": "3s",
				"retries": 10,
				"start_period": "30s"
			},
			"networks": [
				"private"
			],
			"stop_grace_period": "60s",
			"logging": {
				"driver": "json-file",
				"options": {
					"max-size": "10m",
					"max-file": "5"
				}
			},
			"ports": [
				"127.0.0.1:15432:5432"
			]
		}
	},
	"networks": {
		"private": {
			"internal": true
		}
	},
	"volumes": {
		"postgres-data": {},
		"objects": {}
	}
}
