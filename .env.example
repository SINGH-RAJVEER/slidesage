# Base URL for the APIs service the web app will call
VITE_API_URL=http://localhost:8000

# Better Auth Configuration
AUTH_SECRET=your-secret-key-change-in-production
AUTH_URL=http://localhost:8000

# OAuth Provider Credentials
# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# AI API Keys
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=

# LiteLLM Configuration
# Main model for presentation generation and general tasks
LITELLM_MODEL=groq/llama-3.3-70b-versatile
# Model for search operations and summarization
LITELLM_SEARCH_MODEL=llama-3.1-8b-instant
# Proxy base URL for LiteLLM (default: http://localhost:4000)
LITELLM_PROXY_BASE=http://localhost:4000
# Optional: API key if your LiteLLM instance requires authentication
LITELLM_API_KEY=

# RAG (Retrieval Augmented Generation) Configuration
# Embedding model for semantic search (via LiteLLM)
# Supports: nomic-embed-text-v1.5 (1536 dims), text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=nomic-embed-text-v1.5
# RAG tuning parameters
# RAG_SIMILARITY_THRESHOLD=0.6
# RAG_TOP_K_CONTEXTS=5

# APIs Configuration
PORT=8000
BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql://slidesage:slidesage@localhost:5432/slidesage

# Docker Database Configuration
POSTGRES_USER=slidesage
POSTGRES_PASSWORD=slidesage
# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
