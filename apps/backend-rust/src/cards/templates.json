	"mono-briefing": {
		"document": {
			"schemaVersion": 3,
			"title": "A system we can trust",
			"theme": "mono",
			"cardOrder": [
				"c_2760qyvopkw",
				"c_1cc8ug51nj7",
				"c_8uz5vtclel",
				"c_t4i06ocw7g",
				"c_1b9b1fyozyg"
			],
			"cards": {
				"c_2760qyvopkw": {
					"id": "c_2760qyvopkw",
					"takeaway": "Make reliability a property of the system",
					"role": "opening",
					"layout": "title",
					"nodes": [
						{
							"id": "n_1nj5fvpqlvh",
							"type": "heading",
							"text": [
								{
									"text": "A system we can trust"
								}
							]
						},
						{
							"id": "n_hjpaien087",
							"type": "paragraph",
							"text": [
								{
									"text": "A technical briefing on making background jobs observable and safe to retry."
								}
							]
						}
					],
					"sourceIds": [],
					"notes": "Starter content is illustrative. Replace claims and figures with your own evidence before presenting."
				},
				"c_1cc8ug51nj7": {
					"id": "c_1cc8ug51nj7",
					"takeaway": "A retry must not repeat a completed side effect",
					"role": "context",
					"layout": "image-right",
					"nodes": [
						{
							"id": "n_26a7vdupn07",
							"type": "heading",
							"text": [
								{
									"text": "The failure we need to handle"
								}
							]
						},
						{
							"id": "n_b1xwofbart",
							"type": "paragraph",
							"text": [
								{
									"text": "A worker can finish a job and lose its connection before acknowledging it. A retry should find the completed result rather than apply the same change again."
								}
							]
						},
						{
							"id": "n_pp3nl6ate7",
							"type": "image",
							"assetId": "a9f55fe74dddfa672920e9086eb332bfae9a230ffc1a71d541cd4ebac86d91a7",
							"alt": "Engineers reviewing work together",
							"fit": "cover",
							"focus": {
								"x": 0.5,
								"y": 0.5
							}
						}
					],
					"sourceIds": [],
					"notes": "Starter content is illustrative. Replace claims and figures with your own evidence before presenting."
				},
				"c_8uz5vtclel": {
					"id": "c_8uz5vtclel",
					"takeaway": "Choose the consistency model deliberately",
					"role": "comparison",
					"layout": "comparison",
					"nodes": [
						{
							"id": "n_1lo4m68gmvl",
							"type": "heading",
							"text": [
								{
									"text": "Two approaches to retries"
								}
							]
						},
						{
							"id": "n_1j8rp2667d0",
							"type": "columns",
							"columns": [
								{
									"id": "i_kfn95ngc9l",
									"heading": "Best effort",
									"items": [
										{
											"id": "i_1w0q9mcgzt8",
											"text": [
												{
													"text": "Simple workers and low coordination"
												}
											]
										},
										{
											"id": "i_22h2rmhxgwn",
											"text": [
												{
													"text": "Duplicate effects require cleanup"
												}
											]
										}
									]
								},
								{
									"id": "i_1f65255o137",
									"heading": "Idempotent jobs",
									"items": [
										{
											"id": "i_2b2ehu96tyw",
											"text": [
												{
													"text": "Stable keys identify completed work"
												}
											]
										},
										{
											"id": "i_w5pd9spwzo",
											"text": [
												{
													"text": "State transitions need explicit rules"
												}
											]
										}
									]
								}
							]
						}
					],
					"sourceIds": [],
					"notes": "Starter content is illustrative. Replace claims and figures with your own evidence before presenting."
				},
				"c_t4i06ocw7g": {
					"id": "c_t4i06ocw7g",
					"takeaway": "Migrate in steps that can be measured",
					"role": "process",
					"layout": "process",
					"nodes": [
						{
							"id": "n_tcictgwsws",
							"type": "heading",
							"text": [
								{
									"text": "A measured migration"
								}
							]
						},
						{
							"id": "n_wl82x5n4wp",
							"type": "steps",
							"items": [
								{
									"id": "i_2c5i1xjzs4z",
									"title": "Instrument",
									"detail": [
										{
											"text": "Record attempts, results and latency."
										}
									]
								},
								{
									"id": "i_1mktvnk604r",
									"title": "Protect",
									"detail": [
										{
											"text": "Add stable keys to side effects."
										}
									]
								},
								{
									"id": "i_248ev9zu0de",
									"title": "Verify",
									"detail": [
										{
											"text": "Test recovery before wider rollout."
										}
									]
								}
							]
						}
					],
					"sourceIds": [],
					"notes": "Starter content is illustrative. Replace claims and figures with your own evidence before presenting."
				},
				"c_1b9b1fyozyg": {
					"id": "c_1b9b1fyozyg",
					"takeaway": "Review the design with a real failure scenario",
					"role": "closing",
					"layout": "title",
					"nodes": [
						{
							"id": "n_278n9efj9vh",
							"type": "heading",
