{
  "name": "slide-sage-backend",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "echo 'No build step for backend'",
    "db:generate": "bun run --filter=@slide-sage/database db:generate",
    "db:push": "bun run --filter=@slide-sage/database db:push",
    "db:migrate": "bun run --filter=@slide-sage/database db:migrate",
    "db:studio": "bun run --filter=@slide-sage/database db:studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@slide-sage/database": "workspace:*",
    "@hono/clerk-auth": "^2.0.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "^1.9.4"
  }
}
