{
  "name": "slide-sage-apis",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "echo 'No build step for backend'",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "test:rag": "bun src/scripts/test-rag.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@langchain/core": "^0.1.48",
    "@langchain/groq": "^0.0.12",
    "@slide-sage/contracts": "workspace:*",
    "@slide-sage/db": "workspace:*",
    "better-auth": "^1.4.18",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "langchain": "^0.1.34",
    "postgres": "^3.4.5",
    "resend": "^6.9.2",
    "svix": "^1.84.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@biomejs/biome": "^1.9.4",
    "drizzle-kit": "^0.28.1"
  }
}
